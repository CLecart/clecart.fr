# The Dockerfile copies the whole context into the web root, and nginx serves
# any path that exists there. Everything is excluded by default, so a stray
# file (.git, .env, config.json, node_modules, a local script) can never end up
# downloadable: only what the site serves is listed back in.
*

!index.html
!about-portfolio.html
!descriptions-projects.html
!privacy-policy.html
!cv
!styles.css
!css
!js
!assets
!service-worker.js
!robots.txt
!sitemap.xml

# Copied to /etc/nginx by the Dockerfile, so they must be in the context; the
# whole-context copy also lands them in the web root, where they are readable.
!nginx.conf
!nginx-security-headers.conf
